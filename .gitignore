## Ignore user-local installs and virtual environments
/.venv
venv/
__pycache__/
.pytest_cache/
/.mypy_cache

# Local user installs (do not ignore repo's bin/ or lib/)
~/.local/
~/.local/bin/
~/.local/lib/

# Editor files
.DS_Store
*.swp
*~
.vscode/
.idea/

# Backup files
*.bak
*.tmp

# Logs
*.log

# Test and build artifacts
/test-results/
/.cache/
/.coverage

# Bats test artifacts (optional)
tests/.cache/
tests/output/

# Lint / tooling outputs
shellcheck-report.*
.shellcheck/
coverage.xml
junit-*.xml

# Node.js (if added later)
node_modules/

# GitHub Actions and CI caches
.github/*-cache/
.github/actions/cache/

# Local install stubs (avoid committing user installs)
.local-bin/
.local-lib/

# Ignore system-wide bash completion install location (not in repo)
/etc/bash_completion.d/

test.txt


